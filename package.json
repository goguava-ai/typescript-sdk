{
  "name": "@guava-ai/guava-sdk",
  "description": "The official TypeScript SDK for building Guava voice agents.",
  "homepage": "https://docs.goguava.ai/typescript-sdk/",
  "version": "0.39.0",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./helpers": {
      "types": "./dist/src/helpers/index.d.ts",
      "default": "./dist/src/helpers/index.js"
    },
    "./helpers/openai": {
      "types": "./dist/src/helpers/openai.d.ts",
      "default": "./dist/src/helpers/openai.js"
    },
    "./webrtc": {
      "types": "./dist/src/webrtc/index.d.ts",
      "default": "./dist/src/webrtc/index.js"
    },
    "./example-data": {
      "types": "./dist/src/example-data.d.ts",
      "default": "./dist/src/example-data.js"
    },
    "./example-utils": {
      "types": "./dist/src/example-utils.d.ts",
      "default": "./dist/src/example-utils.js"
    },
    "./examples/help-desk": {
      "types": "./dist/examples/help-desk.d.ts",
      "default": "./dist/examples/help-desk.js"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.7",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.5.2",
    "openai": "^6.16.0",
    "ts-jest": "^29.4.11",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "openai": "^6.16.0"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    }
  },
  "bin": {
    "guava-example": "dist/bin/example-runner.js"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ws": "^8.19.0",
    "zod": "^4.3.5"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --max-diagnostics=none",
    "lint-fix": "biome lint --max-diagnostics=none --write",
    "autofix": "npm run format && npm run lint-fix",
    "check-format": "biome format ./src ./examples",
    "format": "biome format --write ./src ./examples",
    "test": "jest",
    "test:e2e": "jest --config jest.e2e.config.cjs",
    "check": "npm run typecheck && npm audit --omit=dev && npm run lint && npm run check-format",
    "clean": "rm -rf ./dist",
    "build": "tsx scripts/update-version.ts && tsc && chmod +x ./dist/bin/example-runner.js && npm run build-webrtc && tsx scripts/update-readme.ts",
    "build-webrtc": "npm run build-webrtc:esm && npm run build-webrtc:iife",
    "build-webrtc:esm": "esbuild src/webrtc/index.ts --bundle --minify --sourcemap --target=es2020 --format=esm --outfile=dist/guava-webrtc.esm.min.js",
    "build-webrtc:iife": "esbuild src/webrtc/index.ts --bundle --minify --sourcemap --target=es2020 --format=iife --global-name=Guava --outfile=dist/guava-webrtc.min.js",
    "prepare": "npm run clean && npm run build",
    "release": "npm publish --ignore-scripts=false"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "/src",
    "/dist",
    "/examples",
    "/bin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goguava-ai/typescript-sdk.git"
  }
}
